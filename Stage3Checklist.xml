<?xml version="1.0" encoding="utf-8"?>
<ArrayOfCheckListItem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
	<CheckListItem>
		<TrueColor>Green</TrueColor>
		<FalseColor>Red</FalseColor>
		<Description>BlackBox logging active and MicroSD detected</Description>
		<Text>{value}</Text>
		<TriggerValue>1</TriggerValue>
		<Name>blackbox_logging</Name>
		<ConditionType>EQ</ConditionType>
	</CheckListItem>
	<CheckListItem>
		<TrueColor>Green</TrueColor>
		<FalseColor>Red</FalseColor>
		<Description>Battery charge</Description>
		<Text>{value} V (target 50.4 V)</Text>
		<TriggerValue>50.4</TriggerValue>
		<Name>battery_voltage</Name>
		<ConditionType>GTEQ</ConditionType>
	</CheckListItem>
	<CheckListItem>
		<TrueColor>Green</TrueColor>
		<FalseColor>Red</FalseColor>
		<Description>ADS-B transmitter reports healthy</Description>
		<Text>TX failure: {value}</Text>
		<TriggerValue>0</TriggerValue>
		<Name>xpdr_adsb_tx_sys_fail</Name>
		<ConditionType>EQ</ConditionType>
		<IsArmingBlocker>true</IsArmingBlocker>
	</CheckListItem>
	<CheckListItem>
		<TrueColor>Green</TrueColor>
		<FalseColor>Red</FalseColor>
		<Description>GPS 3D fix (fix type ≥ 3)</Description>
		<Text>Fix type: {value}</Text>
		<TriggerValue>3</TriggerValue>
		<Name>gpsstatus</Name>
		<ConditionType>GTEQ</ConditionType>
		<IsArmingBlocker>true</IsArmingBlocker>
	</CheckListItem>
	<CheckListItem>
		<TrueColor>Green</TrueColor>
		<FalseColor>Red</FalseColor>
		<Description>GPS HDOP ≤ 2.5</Description>
		<Text>HDOP: {value}</Text>
		<TriggerValue>2.5</TriggerValue>
		<Name>gpshdop</Name>
		<ConditionType>LTEQ</ConditionType>
		<IsArmingBlocker>true</IsArmingBlocker>
	</CheckListItem>
	<CheckListItem>
		<TrueColor>Green</TrueColor>
		<FalseColor>Red</FalseColor>
		<Description>Minimum satellite count</Description>
		<Text>Sats: {value}</Text>
		<TriggerValue>8</TriggerValue>
		<Name>satcount</Name>
		<ConditionType>GTEQ</ConditionType>
		<IsArmingBlocker>true</IsArmingBlocker>
	</CheckListItem>
	<CheckListItem>
		<TrueColor>Green</TrueColor>
		<FalseColor>Red</FalseColor>
		<Description>Autopilot PreArm checks passing</Description>
		<Text>PreArm OK: {value}</Text>
		<TriggerValue>1</TriggerValue>
		<Name>prearmstatus</Name>
		<ConditionType>EQ</ConditionType>
		<IsArmingBlocker>true</IsArmingBlocker>
	</CheckListItem>
	<CheckListItem>
		<TrueColor>Green</TrueColor>
		<FalseColor>Red</FalseColor>
		<Description>GCS link quality ≥ 50%</Description>
		<Text>Link: {value}%</Text>
		<TriggerValue>50</TriggerValue>
		<Name>linkqualitygcs</Name>
		<ConditionType>GTEQ</ConditionType>
		<IsArmingBlocker>true</IsArmingBlocker>
	</CheckListItem>
	<CheckListItem>
		<TrueColor>White</TrueColor>
		<FalseColor>White</FalseColor>
		<Description>Confirm all sensors report healthy on status tab</Description>
		<Text />
		<TriggerValue>0</TriggerValue>
		<Name>roll</Name>
		<ConditionType>NONE</ConditionType>
		<IsArmingBlocker>true</IsArmingBlocker>
	</CheckListItem>
	<CheckListItem>
		<TrueColor>White</TrueColor>
		<FalseColor>White</FalseColor>
		<Description>Confirm radio control and telemetry are nominal</Description>
		<Text />
		<TriggerValue>0</TriggerValue>
		<Name>roll</Name>
		<ConditionType>NONE</ConditionType>
		<IsArmingBlocker>true</IsArmingBlocker>
	</CheckListItem>
	<CheckListItem>
		<TrueColor>White</TrueColor>
		<FalseColor>White</FalseColor>
		<Description>Review ADS-B traffic near mission / home (Stage 3)</Description>
		<Text />
		<TriggerValue>0</TriggerValue>
		<Name>roll</Name>
		<ConditionType>NONE</ConditionType>
		<IsArmingBlocker>true</IsArmingBlocker>
	</CheckListItem>
	<CheckListItem>
		<TrueColor>White</TrueColor>
		<FalseColor>Red</FalseColor>
		<Description>PIC final inspection complete</Description>
		<Text>Required before arming</Text>
		<TriggerValue>0</TriggerValue>
		<Name>roll</Name>
		<ConditionType>NONE</ConditionType>
		<IsArmingBlocker>true</IsArmingBlocker>
	</CheckListItem>
	<CheckListItem>
		<TrueColor>White</TrueColor>
		<FalseColor>Red</FalseColor>
		<Description>GCO final inspection complete</Description>
		<Text>Required before arming</Text>
		<TriggerValue>0</TriggerValue>
		<Name>roll</Name>
		<ConditionType>NONE</ConditionType>
		<IsArmingBlocker>true</IsArmingBlocker>
	</CheckListItem>
